# Firebase service account JSON (production only — paste minified JSON string)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Local dev: place serviceAccountKey.json in the backend root directory
# Download it from Firebase Console → Project Settings → Service Accounts

# Port — Render sets this automatically; use 5001 locally
PORT=5001

# JWT secret — use a long random string in production
JWT_SECRET=your_jwt_secret_here

# Frontend origin allowed by CORS
# Local dev:         http://localhost:3002
# Production web:    https://lockin-frontend.onrender.com
# Capacitor iOS/Android origins (capacitor://localhost, ionic://localhost)
#   are always allowed automatically — no change needed here for native builds
FRONTEND_URL=https://lockin-frontend.onrender.com

NODE_ENV=development
